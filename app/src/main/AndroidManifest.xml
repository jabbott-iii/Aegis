<?xml version="1.0" encoding="utf-8"?>
<!--
  This manifest requests no permissions. Libraries merge in one signature-level self permission,
  listed in docs/permissions-and-policy.md, "Exported components and merged manifest entries".
  Every new <uses-permission> and every exported component must appear there first (use
  /add-permission).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".AegisApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aegis">

        <!-- The launcher entry point. It must be exported and accepts no data or extras. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
