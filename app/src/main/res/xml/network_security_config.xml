<?xml version="1.0" encoding="utf-8"?>
<!--
  NFR-SEC-04 and ADR-0002: no cleartext, and only system CAs. User-installed CAs are never trusted
  for Aegis's own connections, in any build type.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
